# ============================================
# Coastal Flood Intelligence - Environment Variables
# ============================================
# Copy this to .env and fill in your credentials
# Only Open-Meteo and NOAA NDBC work without credentials

# Copernicus Data Space (FREE registration)
# Register at: https://dataspace.copernicus.eu/
COPERNICUS_DATASPACE_USERNAME=
COPERNICUS_DATASPACE_PASSWORD=

# Copernicus Marine Service (FREE registration)
# Register at: https://marine.copernicus.eu/
COPERNICUS_MARINE_USERNAME=
COPERNICUS_MARINE_PASSWORD=

# NASA Earthdata (FREE registration)
# Register at: https://urs.earthdata.nasa.gov/
NASA_EARTHDATA_USERNAME=
NASA_EARTHDATA_PASSWORD=

# StormGlass (PAID - optional, we simulate this)
# Register at: https://stormglass.io/
STORMGLASS_API_KEY=