APP_ENV=development
APP_DEBUG=true

# Open-Meteo (no key required for free tier)
OPEN_METEO_BASE_URL=https://marine-api.open-meteo.com/v1/marine

# Copernicus Data Space (optional)
COPERNICUS_CLIENT_ID=
COPERNICUS_CLIENT_SECRET=

# Copernicus Marine (optional)
COPERNICUS_MARINE_USERNAME=
COPERNICUS_MARINE_PASSWORD=

# NASA Earthdata (optional)
NASA_EARTHDATA_TOKEN=

# Global Fishing Watch (optional)
GFW_API_TOKEN=

# LLM (optional - deterministic copilot works without this)
OPENAI_API_KEY=

# Frontend
VITE_API_URL=http://localhost:8000
